# Скопируйте этот файл в .env и заполните реальными значениями.
# .env не попадает в git (см. .gitignore).

# --- PostgreSQL (используется docker-compose.yml и backend) ---
POSTGRES_USER=autoparts
POSTGRES_PASSWORD=change-me
POSTGRES_DB=autoparts

# --- Backend ---
# Основная база. Порт и хост совпадают с портом, который публикует сервис db.
DATABASE_URL=postgresql+psycopg://autoparts:change-me@127.0.0.1:5432/autoparts
# Тестовая база, создаётся init-скриптом docker/initdb при первом старте контейнера.
TEST_DATABASE_URL=postgresql+psycopg://autoparts:change-me@127.0.0.1:5432/autoparts_test

# Секрет для будущей авторизации (подпись/соль). Сгенерируйте случайную строку для реального сервера.
SECRET_KEY=change-me-to-a-random-string
# true на проде (HTTPS), false при локальной разработке по http.
COOKIE_SECURE=false
