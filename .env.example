# Скопируйте этот файл в .env и заполните реальными значениями.
# .env не попадает в git (см. .gitignore).

# --- PostgreSQL (используется docker-compose.yml и backend) ---
POSTGRES_USER=qoima
POSTGRES_PASSWORD=change-me
POSTGRES_DB=qoima

# --- Backend ---
# Основная база. Порт и хост совпадают с портом, который публикует сервис db.
DATABASE_URL=postgresql+psycopg://qoima:change-me@127.0.0.1:5432/qoima
# Тестовая база, создаётся init-скриптом docker/initdb при первом старте контейнера.
TEST_DATABASE_URL=postgresql+psycopg://qoima:change-me@127.0.0.1:5432/qoima_test

# true на проде (HTTPS), false при локальной разработке по http.
COOKIE_SECURE=false

# true: отдавать /docs, /redoc и /openapi.json. На проде false (задано в deploy/docker-compose.prod.yml).
ENABLE_DOCS=true
