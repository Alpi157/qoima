# Caddy for Qoima. DOMAIN comes from .env.prod; for a local check DOMAIN=localhost
# (Caddy then uses its own local CA instead of Let's Encrypt).
#
# trusted_proxies is deliberately not set: Caddy then ignores any X-Forwarded-For sent by the
# client and passes the real peer address to the api, so the login limit cannot be bypassed.

# Explicit HTTP site instead of Caddy's automatic redirect, only to drop the Server header there too.
# Port 80 must stay open: Let's Encrypt HTTP-01 challenges are still answered before this block.
http://{$DOMAIN} {
	header -Server
	redir https://{host}{uri} 308
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# style-src 'unsafe-inline': Mantine sets inline styles.
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle /assets/* {
		root * /srv
		@asset_file file {path}
		header @asset_file Cache-Control "public, max-age=31536000, immutable"
		@missing_asset not file {path}
		header @missing_asset Cache-Control "no-cache"
		respond @missing_asset 404
		file_server
	}

	handle {
		root * /srv
		header Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
