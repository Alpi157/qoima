# Настройки продакшн-стека. Скопируйте в deploy/.env.prod и заполните:
#   cp deploy/.env.prod.example deploy/.env.prod && chmod 600 deploy/.env.prod
# deploy/.env.prod не попадает в git (.gitignore). Файл читают все три сервиса
# (env_file в docker-compose.prod.yml), значения пишутся без кавычек.

# --- Caddy ---
# Домен сайта. На него должна указывать A-запись DNS, порты 80 и 443 открыты:
# Caddy сам получит сертификат Let's Encrypt. Для локальной проверки: localhost.
DOMAIN=qoima.example.kz

# --- PostgreSQL ---
POSTGRES_USER=qoima
# Длинный случайный пароль: openssl rand -hex 24
# (hex не требует экранирования в DATABASE_URL ниже).
POSTGRES_PASSWORD=change-me
POSTGRES_DB=qoima

# --- Backend ---
# Тот же пользователь, пароль и база, хост db (имя сервиса в compose).
DATABASE_URL=postgresql+psycopg://qoima:change-me@db:5432/qoima

# COOKIE_SECURE=true, ENABLE_DOCS=false и FORWARDED_ALLOW_IPS заданы в docker-compose.prod.yml,
# здесь их указывать не нужно.
